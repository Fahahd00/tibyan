# ─────────────────────────────────────────────────────────────
# تِبْيان | Tibyan — environment template
# Copy to .env and fill in your own values:   cp .env.example .env
# Never commit .env. Every variable below is safe to leave as-is
# for local development except where marked REQUIRED.
# ─────────────────────────────────────────────────────────────

# development | production | test
APP_ENV=development
LOG_LEVEL=info

# ── Database (PostgreSQL 16 + pgvector) ──────────────────────
POSTGRES_USER=tibyan
POSTGRES_PASSWORD=tibyan_local_dev_only
POSTGRES_DB=tibyan
POSTGRES_PORT=5432
# Used by apps/api and services/ai when running outside Docker.
# Inside docker compose the host is overridden to "db".
DATABASE_URL=postgresql://tibyan:tibyan_local_dev_only@localhost:5432/tibyan

# ── Service wiring ───────────────────────────────────────────
WEB_PORT=3000
API_PORT=4000
AI_PORT=8000
AI_SERVICE_URL=http://localhost:8000
# Where the Next.js server forwards same-origin /api/* calls (the browser never calls the API directly).
API_INTERNAL_URL=http://localhost:4000
# Comma-separated list of extra origins allowed to call the API directly (CORS).
CORS_ORIGINS=http://localhost:3000
# Shared secret between apps/api and services/ai. Generate one with:
#   openssl rand -hex 32
INTERNAL_API_TOKEN=change-me-to-a-random-hex-string
# How long the API gateway waits for the AI service (ms). Keep above LLM_BUDGET_S + LLM_TIMEOUT_S.
AI_TIMEOUT_MS=180000
# Bearer token for /api/admin/* endpoints. Leave empty to disable admin.
ADMIN_TOKEN=

# ── AI providers ─────────────────────────────────────────────
# LLM_PROVIDER:
#   auto      → OpenAI if OPENAI_API_KEY and OPENAI_MODEL are set, else Claude if ANTHROPIC_API_KEY is set,
#               else extractive mode (default)
#   openai    → always OpenAI          anthropic → always Claude
#   none      → extractive mode only: verbatim sentences from approved sources, no generative model
# The LLM never answers on its own and never searches the web: it only restates retrieved evidence as claims with
# verbatim quotes, and every claim is verified against the source before it can be shown.
# Keys belong in .env only (git-ignored) — never in code, frontend, docs or tests.
LLM_PROVIDER=auto

# OpenAI (Responses API, structured outputs, no tools, store=false)
OPENAI_API_KEY=
# Required for OpenAI — no built-in default. Use a current model that supports Structured Outputs.
OPENAI_MODEL=
# Only for reasoning models (low | medium | high); leave empty otherwise.
OPENAI_REASONING_EFFORT=
# Leave empty for api.openai.com.
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Effort per task: low | medium | high
ANTHROPIC_GENERATION_EFFORT=medium
ANTHROPIC_JUDGE_EFFORT=low

# Shared limits. Connect timeout is 5 s; on an outage the provider stops calling for 60 s (10 min after an auth
# error) and Tibyan uses extractive mode.
LLM_TIMEOUT_S=40
LLM_MAX_RETRIES=1
# Wall-clock budget for the LLM path of one question (seconds); beyond it the answer falls back to extractive mode.
LLM_BUDGET_S=100
# Optional LLM sensitivity classifier (it can only RAISE sensitivity above the rule-based floor).
LLM_CLASSIFIER=true

# Live search: when the index cannot answer, search the approved websites (Ibn Baz / Ibn Uthaymeen first, then the
# fallback authorities), index the fatwa pages found verbatim, and answer from them. Needs OPENAI_API_KEY.
# LIVE_SEARCH=true
# LIVE_SEARCH_MAX_PAGES=4

# ── LLM cost controls (docs/LLM_COST.md) ─────────────────────
# extractive_first: answer verbatim from the source when that passes verification; the LLM only otherwise.
# llm_first: the LLM writes every answer (previous behaviour).
ANSWER_STRATEGY=extractive_first
# Identical LLM requests (same model, settings, prompts, evidence) are answered from the database.
LLM_CACHE=true
LLM_CACHE_TTL_DAYS=30
# Upper bound for one LLM response (reasoning included); a truncated response falls back to extractive mode.
LLM_MAX_OUTPUT_TOKENS=8000
# Daily ceilings (UTC). When reached, Tibyan answers in extractive mode until the next day. 0 disables.
LLM_DAILY_BUDGET_USD=5
LLM_DAILY_CALL_LIMIT=1500
# USD per 1M tokens for the cost estimate. Leave unset to use the built-in price of known models
# (gpt-5.4-mini: 0.75 input / 0.075 cached input / 4.50 output, OpenAI pricing page, 2026-10-04).
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_CACHED_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# Embeddings are local (EMBEDDING_PROVIDER=fastembed); OPENAI_EMBEDDING_MODEL is only used with EMBEDDING_PROVIDER=openai.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STT_MODEL=whisper-1
# Server voice (TTS_PROVIDER=openai): gpt-4o-mini-tts follows OPENAI_TTS_INSTRUCTIONS (tone/accent);
# OpenAI recommends the marin and cedar voices for the best quality.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
# OPENAI_TTS_INSTRUCTIONS=

# EMBEDDING_PROVIDER: fastembed (local, default) | openai
# Changing the provider/model requires re-indexing: npm run db:reindex
# (and a migration if EMBEDDING_DIM changes — the column is vector(1024)).
# multilingual-e5-large: ~2.2 GB, downloaded once on first run; uses ~1.5–2 GB RAM in the AI service and seed.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
# Where local models are cached (downloaded on first use).
FASTEMBED_CACHE_DIR=./.cache/fastembed

# RERANKER: rrf (default, no model) | cross-encoder (downloads ~1.1 GB on first use)
RERANKER=rrf
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual

# VERIFIER: auto (LLM entailment judge when an LLM is configured) | llm | lexical (accepts verbatim claims only)
VERIFIER=auto

# Voice. browser = Web Speech API in the user's browser (no server keys needed);
# openai = OpenAI speech (needs OPENAI_API_KEY; TTS only ever reads stored, verified answers).
STT_PROVIDER=browser
TTS_PROVIDER=browser

# ── Retrieval tuning ─────────────────────────────────────────
RETRIEVAL_CANDIDATES=24
RETRIEVAL_TOP_K=6
# Minimum cosine similarity for the best dense hit before we consider evidence "found".
MIN_DENSE_SIMILARITY=0.55
# Extractive mode only (no LLM / LLM outage): a fatwa is quoted only above this cosine AND when it contains
# every key term of the question. Calibrated for multilingual-e5-large (docs/SEMANTIC_EVALUATION.md).
EXTRACTIVE_MIN_DENSE=0.83
